{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GreenBoost Gaming Suite",
  "version": "0.1.0",
  "identifier": "com.ferran.greenboost-gaming-suite",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "label": "main",
        "title": "GreenBoost Gaming Suite",
        "width": 1350,
        "height": 950,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true,
        "fullscreen": false,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$HOME/.local/share/Steam/appcache/librarycache/**",
          "$HOME/.steam/steam/appcache/librarycache/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "desktopTemplate": "greenboost-gaming.desktop.hbs"
      }
    }
  }
}
