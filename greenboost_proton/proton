#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""GreenBoost Proton , launch stub.

This file exists for one reason: to make the invariant stated in
gb_proton_main.py actually true.

    A performance wrapper must never be able to prevent the game from
    launching.

gb_proton_main.py already wraps its own work in try/except and falls back to
a bare upstream Proton launch.  That net cannot catch everything, because it
only exists once the file has been PARSED.  A SyntaxError, an ImportError at
module scope, or a corrupt/half-written deploy kills the wrapper before any
of its handling exists, and Steam simply reports the game as stopped one
second after starting it.  That happened on 2026-08-20 and cost a whole
evening of launches.

So the entry point Steam invokes is this stub, which:

  1. compiles gb_proton_main.py  (a SyntaxError surfaces HERE, catchably),
  2. executes it as __main__,
  3. on any failure that is not a deliberate exit, records what happened and
     hands the launch to upstream Proton unchanged.

KEEP THIS FILE BORING.  It is parsed by the sniper container's python3 3.9,
it must never import anything from the project, and every line of it is a
line that can take a launch down.  Old, dull syntax only: no f-strings, no
dataclasses, no typing, no walrus.  If you are adding a feature, it belongs
in gb_proton_main.py, not here.
"""

import os
import sys


LOG_DIR = os.path.join(
    os.environ.get("XDG_DATA_HOME", os.path.expanduser("~/.local/share")),
    "greenboost", "proton-logs")


def _appid():
    """Best-effort AppID, by the same ladder gb_proton_main.py uses."""
    for var in ("SteamGameId", "SteamAppId", "STEAM_APPID"):
        val = os.environ.get(var, "").strip()
        if val:
            return val
    compat = os.environ.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if compat:
        base = os.path.basename(compat)
        if base.isdigit():
            return base
    return "unknown"


def _record(text):
    """Write the crash record where the Suite looks for launch failures.

    gb_proton_main.py normally tees stderr into this same file, but on a
    parse error that tee never installs , which is exactly the case that
    left the Games view saying "Launching ... verified" for a game that had
    already died.  The stub owns the file so the record survives regardless.
    """
    sys.stderr.write(text)
    try:
        if not os.path.isdir(LOG_DIR):
            os.makedirs(LOG_DIR)
        handle = open(os.path.join(LOG_DIR, "greenboost-proton-%s.log" % _appid()), "a")
        try:
            handle.write(text)
        finally:
            handle.close()
    except Exception:
        pass  # a missing log must never be the thing that stops a launch


def _steam_common_dirs():
    dirs = []
    for base in (
            os.environ.get("STEAM_BASE_FOLDER", ""),
            os.path.expanduser("~/.local/share/Steam"),
            os.path.expanduser("~/.steam/root"),
            os.path.expanduser("~/.steam/steam")):
        if base:
            dirs.append(os.path.join(base, "steamapps", "common"))
    seen = []
    for d in dirs:
        if d not in seen:
            seen.append(d)
    return seen


def _find_upstream():
    """Minimal upstream discovery for the fallback path only.

    Deliberately duplicated from gb_proton_main.py rather than imported: the
    whole point of this path is that gb_proton_main.py could not be loaded.
    Kept dumb , the full resolver, with the channel sidecar and the version
    ranking, lives in the module.
    """
    override = os.environ.get("GREENBOOST_PROTON_UPSTREAM", "").strip()
    if override:
        if os.path.isdir(override):
            override = os.path.join(override, "proton")
        if os.path.isfile(override):
            return override

    candidates = []
    for common in _steam_common_dirs():
        if not os.path.isdir(common):
            continue
        try:
            entries = sorted(os.listdir(common))
        except OSError:
            continue
        for entry in entries:
            path = os.path.join(common, entry, "proton")
            if not os.path.isfile(path):
                continue
            name = entry.lower()
            if "greenboost" in name:
                continue  # never delegate to ourselves
            # Prefer Experimental, then anything else that calls itself Proton.
            candidates.append((0 if "experimental" in name else 1, entry, path))
    if not candidates:
        return None
    candidates.sort()
    return candidates[0][2]


def _delegate(reason):
    upstream = _find_upstream()
    if not upstream:
        _record(
            "[greenboost-proton] GreenBoost could not start and no upstream "
            "Proton was found to fall back to, so this launch cannot "
            "continue.\n"
            "[greenboost-proton] Install Proton Experimental in Steam "
            "(Library -> Tools), or set GREENBOOST_PROTON_UPSTREAM to the "
            "Proton you want to use.\n")
        return 1
    _record("[greenboost-proton] launching on %s instead, without GreenBoost "
            "optimisations. The game itself is unaffected.\n" % upstream)
    try:
        os.execv(upstream, [upstream] + sys.argv[1:])
    except OSError as exc:
        _record("[greenboost-proton] handing off to %s failed: %r\n"
                % (upstream, exc))
        return 1
    return 1  # not reached


def main():
    body = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "gb_proton_main.py")

    try:
        handle = open(body, "r")
        try:
            source = handle.read()
        finally:
            handle.close()
        code = compile(source, body, "exec")
    except SyntaxError as exc:
        _record(
            "[greenboost-proton] GreenBoost did not run: its wrapper is "
            "written in newer Python than the one Steam runs it with.\n"
            "[greenboost-proton]   %s, line %s: %s\n"
            "[greenboost-proton]   this Python: %s (Steam runs the wrapper "
            "inside its own runtime container, not with your system "
            "Python)\n"
            "[greenboost-proton] Your game still starts , see the next line "
            "for what it falls back to. What you lose is GreenBoost itself "
            "for this launch: no virtual VRAM, no shader-thread tuning, no "
            "power lock. Nothing is broken and no settings changed.\n"
            "[greenboost-proton] To get it back, re-run "
            "greenboost_proton/install.sh , it checks the wrapper against "
            "this exact interpreter and will name whatever needs fixing.\n"
            % (os.path.basename(body), exc.lineno, exc.msg,
               sys.version.split()[0]))
        return _delegate("syntax")
    except Exception as exc:
        _record("[greenboost-proton] GreenBoost did not run: could not read "
                "%s (%r).\n" % (body, exc))
        return _delegate("unreadable")

    namespace = {
        "__name__": "__main__",
        "__file__": body,
        "__builtins__": __builtins__,
    }
    try:
        exec(code, namespace)
    except SystemExit:
        raise                      # the wrapper's own exit code, pass it through
    except KeyboardInterrupt:
        raise
    except BaseException as exc:
        _record("[greenboost-proton] GreenBoost failed before it could start "
                "the game: %r\n" % (exc,))
        return _delegate("runtime")
    return 0


sys.exit(main())
