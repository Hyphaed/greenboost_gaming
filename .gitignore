# Python
__pycache__/
*.py[cod]
.venv/
.cache/
.mcp-cache/

# Vulkan layer build artifact
/libVkLayer_greenboost.so

# OpenGL layer build artifact (WIP)
/libgb_gl.so

# NIS SPIR-V outputs
/build/*.spv

# Tauri / Vite build output
/src/dist/
/src/node_modules/
/src/src-tauri/target/

# TurboQuant build (parent-repo concern; if it ever returns here, add a tq: target first)
/lib/**/*.so
/lib/**/*.o

# Runtime drop-dirs (filled on demand, not source)
/cache/

# Optional user-built offline DLSS bundle , see DLSS_UPDATER.md.
# Never committed: these are NVIDIA-authored binaries under the
# Developer Program EULA, not part of this project.
/dlls/

# NVIDIA DLSS / Streamline DLLs , runtime cache, never committed.
# Fetched on demand by "Update DLSS" from NVIDIA's official GitHub
# repositories. The live cache is ~/.local/share/greenboost-gaming/libraries/;
# this directory only holds README.md + an empty manifest in a fresh clone.
/libraries/*.dll
/libraries/versions/
/libraries/manifest.json

# DLSS 5 (Neural Rendering) staging , NVIDIA-authored DLLs + a third-party
# RenoDX add-on, neither of which this project may redistribute. The user
# supplies these themselves; install.sh mirrors them to
# ~/.local/share/greenboost/dlss5/ the same way it mirrors gb_gaming/. See
# gb_gaming/dlss5.py and docs/dlss5-external-folders.md.
/assets/dlss5/

# GreenBoostDLSS5 (DLSS 5 Neural Rendering fork of OptiScaler_DLSSNR) , only
# the built runtime the installer copies into a game ships here. The source
# tree that builds it (MSVC-only, ~1.3 GB with its own .git) lives outside
# this repo at ../dlssnr, one level up from greenboost_all/. This is the
# repo's one deliberate binary exception: MIT-licensed, and it IS the
# mechanism gb_gaming/optiscaler_installer.py installs , see FORK_NOTES.md.
!/libraries/dlssnr/
!/libraries/dlssnr/runtime/
/libraries/dlssnr/runtime/**/*.pdb
/libraries/dlssnr/runtime/**/*.exp
/libraries/dlssnr/runtime/**/*.lib

# uv / pip build artefacts
/dist/
/*.egg-info/

# AI assistant local context , never commit (use local CLAUDE.md only)
CLAUDE.md
MEMORY.md
memory/
.claude/
.claude-sessions/
.claude_*
*.claude.md
workflow/
skills_needed.md
STALE_FILES.md
AUDIT_*.md
.mcp.json
*.local.json

